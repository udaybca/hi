    <main>

        <!-- About Section -->
        <section id="about" class="about-section">
            <div class="container">
                <h2>About Me</h2>
                <div class="about-content">
                    <img src="profile-placeholder.jpg" alt="Alex Morgan profile picture" class="profile-img">
                    <div class="about-text">
                        <p>Hello! I am a passionate computer science student and aspiring front-end developer. I love building clean, accessible, and responsive web applications using modern HTML5, CSS3, and JavaScript.</p>
                        <p>When I'm not coding, you can find me exploring open-source projects, reading tech blogs, or hiking outdoors.</p>
                    </div>
                </div>
