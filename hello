        <section id="skills" class="skills-section">
            <div class="container">
                <h2>Skills</h2>
                <div class="skills-grid">
                    <div class="skill-card">
                        <h3>HTML5 & CSS3</h3>
                        <p>Semantic markup, Flexbox, CSS Grid, responsive design principles.</p>
                    </div>
                    <div class="skill-card">
                        <h3>JavaScript (ES6+)</h3>
                        <p>DOM manipulation, asynchronous JavaScript, Fetch API, event handling.</p>
                    </div>
                    <div class="skill-card">
                        <h3>Tools & Workflow</h3>
                        <p>Git & GitHub, VS Code, Chrome DevTools, deployment via GitHub Pages.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="projects-section">
            <div class="container">
                <h2>Featured Projects</h2>
                <div class="projects-grid">
                    <article class="project-card">
